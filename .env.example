# ---- Copy this file to ".env" for local testing ----
# In GitHub Actions, these same names go into: Repo -> Settings -> Secrets and variables -> Actions

# Free at https://console.groq.com  (Groq API - free tier, very fast)
GROQ_API_KEY=your_groq_api_key_here

# Free at https://www.pexels.com/api/  (sign up, instant free key)
PEXELS_API_KEY=your_pexels_api_key_here

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client (Desktop app)
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# Generated ONE TIME by running src/get_youtube_token.py locally (see README)
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# Your channel name, shown in watermark
CHANNEL_NAME=News Supernova
